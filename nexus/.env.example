# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Required: the agent's brain.
# ---------------------------------------------------------------------------
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional: web_search provider.
# ---------------------------------------------------------------------------
# web_search picks the first provider that has a key, else falls back to a
# keyless DuckDuckGo HTML endpoint (lower quality, rate-limited, no SLA).
#   brave  -> https://brave.com/search/api/
#   serper -> https://serper.dev/
BRAVE_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: overrides. Defaults shown; leave blank to use them.
# ---------------------------------------------------------------------------
# Path to the agent config file.
NEXUS_CONFIG=config/agent.json

# Sandbox root for file_ops and code_exec. Must stay inside the repo.
NEXUS_WORKSPACE=workspace

# Where JSONL traces are written.
NEXUS_TRACE_DIR=traces

# Set to 1 in CI / cron so approval prompts auto-DENY instead of hanging on a
# missing stdin. Never set this to make prompts auto-APPROVE — there is no such
# option by design.
NEXUS_NONINTERACTIVE=
